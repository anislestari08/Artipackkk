<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>ARTIPACK! — Taste It, Love It, Crave It!</title>
<meta name="description" content="ARTIPACK! — Keripik sukun lokal dengan kemasan modern & aesthetic. Tersedia Personal Pack, Regular, Sharing, Large, Family Pack, stiker label custom, dan custom packaging. Pesan mudah via WhatsApp." />
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700;800&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<style>
  :root {
    --navy: #0B1F3A;
    --navy-soft: #122B4E;
    --navy-light: #1E3A66;
    --gold: #F5B301;
    --gold-soft: #FFD65A;
    --gold-deep: #D99A00;
    --cream: #FFF9EC;
    --cream-soft: #FFFDF7;
    --white: #FFFFFF;
    --text: #1A1A1A;
    --muted: #6B7280;
    --border: rgba(11, 31, 58, 0.12);
    --shadow: 0 10px 30px rgba(11, 31, 58, 0.10);
    --shadow-lg: 0 30px 60px rgba(11, 31, 58, 0.28);
    --radius: 20px;
    --radius-sm: 12px;
    --max: 1180px;
  }

  * { margin: 0; padding: 0; box-sizing: border-box; }
  html { scroll-behavior: smooth; }

  body {
    font-family: 'Plus Jakarta Sans', sans-serif;
    color: var(--text);
    background: var(--cream);
    line-height: 1.65;
    overflow-x: hidden;
  }

  h1, h2, h3, .brand-font {
    font-family: 'Playfair Display', serif;
    letter-spacing: -0.02em;
    font-weight: 700;
  }

  a { text-decoration: none; color: inherit; }
  img { max-width: 100%; display: block; }

  .container {
    width: min(100% - 2rem, var(--max));
    margin-inline: auto;
  }

  /* ===== NAVBAR ===== */
  header {
    position: sticky;
    top: 0;
    z-index: 1000;
    background: rgba(255, 249, 236, 0.94);
    backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--border);
  }

  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.9rem 0;
  }

  .logo {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-family: 'Playfair Display', serif;
    font-weight: 800;
    font-size: 1.35rem;
    color: var(--navy);
  }

  .logo-badge {
    width: 42px;
    height: 42px;
    border-radius: 12px;
    background: var(--navy);
    color: var(--gold);
    display: grid;
    place-items: center;
    font-size: 1.15rem;
    font-weight: 800;
    box-shadow: 0 6px 16px rgba(11, 31, 58, 0.28);
  }

  .logo span { color: var(--gold); }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 1.6rem;
    list-style: none;
  }

  .nav-links a {
    font-size: 0.92rem;
    font-weight: 600;
    color: var(--navy);
    position: relative;
    padding: 0.3rem 0;
    transition: color 0.2s;
  }

  .nav-links a::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: -2px;
    width: 0;
    height: 2px;
    background: var(--gold);
    transition: width 0.25s;
    border-radius: 2px;
  }

  .nav-links a:hover { color: var(--gold-deep); }
  .nav-links a:hover::after { width: 100%; }

  .nav-cta {
    background: var(--navy);
    color: var(--white) !important;
    padding: 0.6rem 1.2rem !important;
    border-radius: 50px;
    font-weight: 700 !important;
    font-size: 0.85rem !important;
    transition: transform 0.2s, background 0.2s;
  }

  .nav-cta::after { display: none !important; }
  .nav-cta:hover { background: var(--gold); color: var(--navy) !important; transform: translateY(-2px); }

  .menu-toggle {
    display: none;
    background: none;
    border: none;
    font-size: 1.6rem;
    color: var(--navy);
    cursor: pointer;
  }

  /* ===== HERO ===== */
  .hero {
    position: relative;
    padding: 4.5rem 0 5rem;
    background:
      radial-gradient(circle at 85% 20%, rgba(245, 179, 1, 0.18), transparent 45%),
      radial-gradient(circle at 10% 80%, rgba(11, 31, 58, 0.10), transparent 40%),
      var(--cream);
    overflow: hidden;
  }

  .hero::before {
    content: '';
    position: absolute;
    top: -80px;
    right: -80px;
    width: 320px;
    height: 320px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(245,179,1,0.22), transparent 70%);
    pointer-events: none;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 3rem;
    align-items: center;
  }

  .hero-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: rgba(11, 31, 58, 0.06);
    color: var(--navy);
    padding: 0.45rem 1rem;
    border-radius: 50px;
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    margin-bottom: 1.2rem;
  }

  .hero-eyebrow .dot {
    width: 8px; height: 8px; border-radius: 50%; background: var(--gold);
    animation: pulse 1.8s infinite;
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.5; transform: scale(1.3); }
  }

  .hero h1 {
    font-size: clamp(2.2rem, 5vw, 3.6rem);
    line-height: 1.1;
    color: var(--navy);
    margin-bottom: 1.2rem;
  }

  .hero h1 .highlight {
    color: var(--gold-deep);
    position: relative;
    display: inline-block;
  }

  .hero h1 .highlight::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 4px;
    width: 100%;
    height: 10px;
    background: rgba(245, 179, 1, 0.3);
    z-index: -1;
    border-radius: 4px;
  }

  .hero p {
    font-size: 1.05rem;
    color: var(--muted);
    max-width: 520px;
    margin-bottom: 2rem;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
    margin-bottom: 2.2rem;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.9rem 1.6rem;
    border-radius: 50px;
    font-weight: 700;
    font-size: 0.92rem;
    border: none;
    cursor: pointer;
    transition: all 0.25s ease;
    font-family: inherit;
  }

  .btn-primary {
    background: var(--navy);
    color: var(--white);
    box-shadow: 0 8px 20px rgba(11, 31, 58, 0.25);
  }

  .btn-primary:hover {
    background: var(--gold);
    color: var(--navy);
    transform: translateY(-3px);
    box-shadow: 0 12px 26px rgba(245, 179, 1, 0.4);
  }

  .btn-outline {
    background: transparent;
    color: var(--navy);
    border: 2px solid var(--navy);
  }

  .btn-outline:hover {
    background: var(--navy);
    color: var(--white);
    transform: translateY(-3px);
  }

  .hero-stats {
    display: flex;
    gap: 2rem;
    flex-wrap: wrap;
  }

  .stat strong {
    display: block;
    font-family: 'Playfair Display', serif;
    font-size: 1.6rem;
    color: var(--navy);
    line-height: 1;
  }

  .stat span {
    font-size: 0.8rem;
    color: var(--muted);
    font-weight: 600;
  }

  /* Hero Visual */
  .hero-visual {
    position: relative;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .hero-card {
    position: relative;
    width: 100%;
    max-width: 380px;
    aspect-ratio: 1 / 1.05;
    border-radius: 28px;
    background: linear-gradient(145deg, var(--navy) 0%, var(--navy-soft) 100%);
    box-shadow: var(--shadow-lg);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 1.8rem;
    color: var(--white);
  }

  .hero-card::before {
    content: '';
    position: absolute;
    top: -60px;
    right: -60px;
    width: 220px;
    height: 220px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(245,179,1,0.55), transparent 70%);
  }

  .hero-card::after {
    content: '🍟';
    position: absolute;
    top: 40%;
    left: 50%;
    transform: translate(-50%, -50%);
    font-size: 7rem;
    filter: drop-shadow(0 10px 20px rgba(0,0,0,0.4));
    animation: float 3.5s ease-in-out infinite;
  }

  @keyframes float {
    0%, 100% { transform: translate(-50%, -50%) translateY(0); }
    50% { transform: translate(-50%, -50%) translateY(-14px); }
  }

  .hero-card .tag {
    display: inline-block;
    background: var(--gold);
    color: var(--navy);
    font-size: 0.7rem;
    font-weight: 800;
    padding: 0.35rem 0.8rem;
    border-radius: 50px;
    letter-spacing: 0.08em;
    margin-bottom: 0.7rem;
    width: fit-content;
    position: relative;
    z-index: 1;
  }

  .hero-card h3 {
    font-size: 1.5rem;
    color: var(--white);
    margin-bottom: 0.3rem;
    position: relative;
    z-index: 1;
  }

  .hero-card p {
    font-size: 0.85rem;
    color: rgba(255,255,255,0.8);
    margin: 0;
    position: relative;
    z-index: 1;
  }

  .hero-float {
    position: absolute;
    background: var(--white);
    border-radius: 14px;
    padding: 0.7rem 1rem;
    box-shadow: var(--shadow);
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--navy);
    animation: float2 4s ease-in-out infinite;
    z-index: 2;
  }

  .hero-float.top { top: 10%; right: -10px; }
  .hero-float.bottom { bottom: 12%; left: -10px; animation-delay: 1.5s; }

  @keyframes float2 {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-10px); }
  }

  .hero-float .icon {
    width: 30px; height: 30px;
    border-radius: 9px;
    background: var(--gold);
    color: var(--navy);
    display: grid;
    place-items: center;
    font-size: 0.9rem;
  }

  /* ===== SECTION ===== */
  section { padding: 4.5rem 0; }

  .section-head {
    text-align: center;
    max-width: 640px;
    margin: 0 auto 3rem;
  }

  .section-head .kicker {
    display: inline-block;
    color: var(--gold-deep);
    font-weight: 800;
    font-size: 0.76rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    margin-bottom: 0.6rem;
  }

  .section-head h2 {
    font-size: clamp(1.8rem, 3.5vw, 2.6rem);
    color: var(--navy);
    margin-bottom: 0.8rem;
  }

  .section-head p {
    color: var(--muted);
    font-size: 1rem;
  }

  /* ===== KEUNGGULAN ===== */
  .features {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
    gap: 1.4rem;
  }

  .feature-card {
    background: var(--white);
    border-radius: var(--radius);
    padding: 1.8rem 1.5rem;
    border: 1px solid var(--border);
    transition: transform 0.3s, box-shadow 0.3s;
    position: relative;
    overflow: hidden;
  }

  .feature-card::before {
    content: '';
    position: absolute;
    top: 0; left: 0;
    width: 100%; height: 4px;
    background: linear-gradient(90deg, var(--gold), var(--gold-soft));
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.35s;
  }

  .feature-card:hover {
    transform: translateY(-6px);
    box-shadow: var(--shadow);
  }

  .feature-card:hover::before { transform: scaleX(1); }

  .feature-icon {
    width: 52px; height: 52px;
    border-radius: 14px;
    background: rgba(245, 179, 1, 0.15);
    color: var(--navy);
    display: grid;
    place-items: center;
    font-size: 1.5rem;
    margin-bottom: 1rem;
  }

  .feature-card h3 {
    font-size: 1.05rem;
    color: var(--navy);
    margin-bottom: 0.5rem;
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-weight: 800;
  }

  .feature-card p {
    font-size: 0.88rem;
    color: var(--muted);
  }

  /* ===== PRODUK UNGGULAN ===== */
  .featured { background: var(--white); }

  .product-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1.5rem;
  }

  .product-card {
    background: var(--cream);
    border-radius: var(--radius);
    overflow: hidden;
    border: 1px solid var(--border);
    transition: transform 0.3s, box-shadow 0.3s;
    display: flex;
    flex-direction: column;
  }

  .product-card:hover {
    transform: translateY(-6px);
    box-shadow: var(--shadow);
  }

  .product-thumb {
    aspect-ratio: 4/3;
    background: linear-gradient(145deg, var(--navy), var(--navy-soft));
    display: grid;
    place-items: center;
    position: relative;
    overflow: hidden;
  }

  .product-thumb::after {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at 70% 30%, rgba(245,179,1,0.35), transparent 60%);
  }

  .product-thumb .emoji {
    font-size: 4rem;
    position: relative;
    z-index: 1;
    filter: drop-shadow(0 8px 16px rgba(0,0,0,0.4));
    transition: transform 0.4s;
  }

  .product-card:hover .product-thumb .emoji { transform: scale(1.12) rotate(-4deg); }

  .product-badge {
    position: absolute;
    top: 12px;
    left: 12px;
    background: var(--gold);
    color: var(--navy);
    font-size: 0.68rem;
    font-weight: 800;
    padding: 0.3rem 0.7rem;
    border-radius: 50px;
    z-index: 2;
    letter-spacing: 0.05em;
  }

  .product-body {
    padding: 1.3rem;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .product-body h3 {
    font-size: 1.15rem;
    color: var(--navy);
    margin-bottom: 0.2rem;
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-weight: 800;
  }

  .product-body .sub {
    font-size: 0.76rem;
    color: var(--gold-deep);
    font-weight: 700;
    margin-bottom: 0.6rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .product-body p {
    font-size: 0.85rem;
    color: var(--muted);
    margin-bottom: 1rem;
    flex: 1;
  }

  .product-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.6rem;
  }

  .price {
    font-family: 'Playfair Display', serif;
    font-size: 1.35rem;
    color: var(--navy);
    font-weight: 700;
  }

  .price small {
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 0.7rem;
    color: var(--muted);
    font-weight: 600;
    display: block;
  }

  .btn-sm {
    padding: 0.55rem 1rem;
    font-size: 0.8rem;
    border-radius: 50px;
    background: var(--navy);
    color: var(--white);
    font-weight: 700;
    border: none;
    cursor: pointer;
    transition: all 0.2s;
    font-family: inherit;
    white-space: nowrap;
  }

  .btn-sm:hover { background: var(--gold); color: var(--navy); transform: translateY(-2px); }

  /* ===== KATALOG ===== */
  .catalog { background: var(--cream); }

  .filter-bar {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.6rem;
    margin-bottom: 2.5rem;
  }

  .filter-btn {
    padding: 0.6rem 1.2rem;
    border-radius: 50px;
    border: 1.5px solid var(--border);
    background: var(--white);
    color: var(--navy);
    font-weight: 700;
    font-size: 0.82rem;
    cursor: pointer;
    transition: all 0.25s;
    font-family: inherit;
  }

  .filter-btn:hover { border-color: var(--gold); color: var(--gold-deep); }

  .filter-btn.active {
    background: var(--navy);
    color: var(--white);
    border-color: var(--navy);
    box-shadow: 0 6px 16px rgba(11,31,58,0.22);
  }

  .catalog-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
    gap: 1.5rem;
  }

  .catalog-card {
    background: var(--white);
    border-radius: var(--radius);
    padding: 1.6rem 1.4rem;
    border: 1px solid var(--border);
    transition: transform 0.3s, box-shadow 0.3s, border-color 0.3s;
    display: flex;
    flex-direction: column;
    position: relative;
    overflow: hidden;
  }

  .catalog-card:hover {
    transform: translateY(-6px);
    box-shadow: var(--shadow);
    border-color: rgba(245, 179, 1, 0.5);
  }

  .catalog-card .size-tag {
    display: inline-block;
    background: rgba(11, 31, 58, 0.06);
    color: var(--navy);
    font-size: 0.72rem;
    font-weight: 800;
    padding: 0.3rem 0.7rem;
    border-radius: 50px;
    width: fit-content;
    margin-bottom: 0.9rem;
    letter-spacing: 0.05em;
  }

  .catalog-card .emoji-lg {
    font-size: 2.6rem;
    margin-bottom: 0.6rem;
  }

  .catalog-card h3 {
    font-size: 1.2rem;
    color: var(--navy);
    margin-bottom: 0.25rem;
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-weight: 800;
  }

  .catalog-card .pack-name {
    font-size: 0.82rem;
    color: var(--gold-deep);
    font-weight: 700;
    margin-bottom: 0.6rem;
  }

  .catalog-card p {
    font-size: 0.85rem;
    color: var(--muted);
    margin-bottom: 1.1rem;
    flex: 1;
  }

  .catalog-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .catalog-price {
    font-family: 'Playfair Display', serif;
    font-size: 1.3rem;
    color: var(--navy);
    font-weight: 700;
  }

  .catalog-card.hidden { display: none; }

  /* ===== STIKER & CUSTOM ===== */
  .special {
    background: linear-gradient(160deg, var(--navy) 0%, var(--navy-soft) 100%);
    color: var(--white);
    position: relative;
    overflow: hidden;
  }

  .special::before {
    content: '';
    position: absolute;
    top: -100px;
    right: -100px;
    width: 350px;
    height: 350px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(245,179,1,0.25), transparent 70%);
  }

  .special .section-head h2 { color: var(--white); }
  .special .section-head p { color: rgba(255,255,255,0.75); }
  .special .section-head .kicker { color: var(--gold); }

  .special-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
    position: relative;
    z-index: 1;
  }

  .special-card {
    background: rgba(255,255,255,0.06);
    border: 1px solid rgba(255,255,255,0.14);
    border-radius: var(--radius);
    padding: 2rem 1.7rem;
    backdrop-filter: blur(8px);
    transition: transform 0.3s, background 0.3s;
  }

  .special-card:hover {
    transform: translateY(-6px);
    background: rgba(255,255,255,0.1);
  }

  .special-card .icon-lg {
    width: 60px; height: 60px;
    border-radius: 16px;
    background: var(--gold);
    color: var(--navy);
    display: grid;
    place-items: center;
    font-size: 1.7rem;
    margin-bottom: 1.2rem;
  }

  .special-card h3 {
    font-size: 1.3rem;
    color: var(--white);
    margin-bottom: 0.6rem;
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-weight: 800;
  }

  .special-card p {
    font-size: 0.9rem;
    color: rgba(255,255,255,0.78);
    margin-bottom: 1.2rem;
  }

  .special-card .price-highlight {
    font-family: 'Playfair Display', serif;
    font-size: 1.5rem;
    color: var(--gold);
    font-weight: 700;
  }

  .special-card ul {
    list-style: none;
    margin: 1rem 0 1.4rem;
  }

  .special-card ul li {
    font-size: 0.85rem;
    color: rgba(255,255,255,0.85);
    padding: 0.3rem 0;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .special-card ul li::before {
    content: '✓';
    color: var(--gold);
    font-weight: 800;
  }

  /* ===== TENTANG ===== */
  .about-grid {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: 3rem;
    align-items: center;
  }

  .about-visual {
    position: relative;
    border-radius: 24px;
    background: linear-gradient(145deg, var(--navy), var(--navy-soft));
    aspect-ratio: 4/5;
    display: grid;
    place-items: center;
    overflow: hidden;
    box-shadow: var(--shadow-lg);
  }

  .about-visual::after {
    content: '🌱';
    font-size: 6rem;
    filter: drop-shadow(0 10px 20px rgba(0,0,0,0.4));
    animation: float 4s ease-in-out infinite;
  }

  .about-visual .badge {
    position: absolute;
    bottom: 20px;
    left: 20px;
    right: 20px;
    background: rgba(255,255,255,0.96);
    border-radius: 14px;
    padding: 1rem;
    text-align: center;
  }

  .about-visual .badge strong {
    display: block;
    color: var(--navy);
    font-family: 'Playfair Display', serif;
    font-size: 1.1rem;
  }

  .about-visual .badge span {
    font-size: 0.78rem;
    color: var(--muted);
  }

  .about-content h2 {
    font-size: clamp(1.8rem, 3.5vw, 2.4rem);
    color: var(--navy);
    margin-bottom: 1rem;
  }

  .about-content > p {
    color: var(--muted);
    margin-bottom: 1.5rem;
  }

  .team-list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 0.8rem;
    margin-bottom: 1.8rem;
  }

  .team-item {
    background: var(--white);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 0.8rem 1rem;
    display: flex;
    align-items: center;
    gap: 0.7rem;
    transition: transform 0.2s, border-color 0.2s;
  }

  .team-item:hover { transform: translateX(4px); border-color: var(--gold); }

  .team-item .avatar {
    width: 34px; height: 34px;
    border-radius: 10px;
    background: var(--navy);
    color: var(--gold);
    display: grid;
    place-items: center;
    font-weight: 800;
    font-size: 0.85rem;
    flex-shrink: 0;
  }

  .team-item span {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--navy);
  }

  .about-quote {
    background: rgba(245, 179, 1, 0.14);
    border-left: 4px solid var(--gold);
    border-radius: 0 12px 12px 0;
    padding: 1rem 1.2rem;
    font-size: 0.9rem;
    color: var(--navy);
    font-weight: 600;
    font-style: italic;
  }

  /* ===== CHECKOUT ===== */
  .checkout { background: var(--white); }

  .checkout-box {
    background: linear-gradient(145deg, var(--navy), var(--navy-soft));
    border-radius: 28px;
    padding: 3rem 2rem;
    text-align: center;
    color: var(--white);
    position: relative;
    overflow: hidden;
    max-width: 820px;
    margin: 0 auto;
    box-shadow: var(--shadow-lg);
  }

  .checkout-box::before {
    content: '';
    position: absolute;
    top: -80px; right: -80px;
    width: 260px; height: 260px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(245,179,1,0.3), transparent 70%);
  }

  .checkout-box > * { position: relative; z-index: 1; }

  .checkout-box h2 {
    font-size: clamp(1.7rem, 3.5vw, 2.3rem);
    color: var(--white);
    margin-bottom: 0.8rem;
  }

  .checkout-box p {
    color: rgba(255,255,255,0.78);
    max-width: 520px;
    margin: 0 auto 2rem;
    font-size: 0.95rem;
  }

  .checkout-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }

  .btn-wa {
    background: #25D366;
    color: #fff;
    box-shadow: 0 8px 20px rgba(37, 211, 102, 0.35);
  }

  .btn-wa:hover {
    background: #1ebe5b;
    color: #fff;
    transform: translateY(-3px);
  }

  .btn-gold {
    background: var(--gold);
    color: var(--navy);
    box-shadow: 0 8px 20px rgba(245, 179, 1, 0.4);
  }

  .btn-gold:hover {
    background: var(--gold-soft);
    color: var(--navy);
    transform: translateY(-3px);
  }

  .checkout-note {
    font-size: 0.78rem;
    color: rgba(255,255,255,0.6);
  }

  /* ===== KONTAK ===== */
  .contact-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 1.5rem;
  }

  .contact-card {
    background: var(--white);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.8rem 1.5rem;
    text-align: center;
    transition: transform 0.3s, box-shadow 0.3s;
  }

  .contact-card:hover {
    transform: translateY(-6px);
    box-shadow: var(--shadow);
  }

  .contact-icon {
    width: 56px; height: 56px;
    border-radius: 16px;
    background: rgba(245, 179, 1, 0.15);
    color: var(--navy);
    display: grid;
    place-items: center;
    font-size: 1.5rem;
    margin: 0 auto 1rem;
  }

  .contact-card h3 {
    font-size: 1.05rem;
    color: var(--navy);
    margin-bottom: 0.5rem;
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-weight: 800;
  }

  .contact-card p, .contact-card a {
    font-size: 0.88rem;
    color: var(--muted);
    line-height: 1.65;
  }

  .contact-card a:hover { color: var(--gold-deep); }

  /* ===== FOOTER ===== */
  footer {
    background: var(--navy);
    color: rgba(255,255,255,0.72);
    padding: 3rem 0 1.5rem;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr;
    gap: 2rem;
    margin-bottom: 2.5rem;
  }

  .footer-brand .logo { color: var(--white); margin-bottom: 0.8rem; }
  .footer-brand .logo span { color: var(--gold); }
  .footer-brand p { font-size: 0.85rem; max-width: 300px; }

  .footer-col h4 {
    color: var(--white);
    font-size: 0.95rem;
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-weight: 800;
    margin-bottom: 1rem;
  }

